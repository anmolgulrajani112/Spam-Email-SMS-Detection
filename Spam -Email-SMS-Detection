        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import urllib.request\n",
        "import zipfile\n",
        "import io\n",
        "\n",
        "from sklearn.feature_extraction.text import TfidfVectorizer\n",
        "from sklearn.metrics import (\n",
        "    accuracy_score, classification_report, confusion_matrix,\n",
        "    ConfusionMatrixDisplay\n",
        ")\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.naive_bayes import MultinomialNB\n",
        "from sklearn.pipeline import Pipeline\n",
        "\n",
        "\n",
        "try:\n",
        "    df = pd.read_csv(\"spam.csv\", encoding=\"latin-1\")\n",
        "except FileNotFoundError:\n",
        "    print(\"spam.csv not found locally. Downloading the SMS Spam Collection dataset...\")\n",
        "    url = \"https://archive.ics.uci.edu/static/public/228/sms+spam+collection.zip\"\n",
        "    with urllib.request.urlopen(url) as response:\n",
        "        with zipfile.ZipFile(io.BytesIO(response.read())) as z:\n",
        "\n",
        "            with z.open(\"SMSSpamCollection\") as f:\n",
        "                df = pd.read_csv(f, sep=\"\\t\", names=[\"v1\", \"v2\"], encoding=\"utf-8\")\n",
        "                df.to_csv(\"spam.csv\", index=False)\n",
        "\n",
        "\n",
        "df = df.rename(columns={\"v1\": \"label\", \"v2\": \"message\"})\n",
        "df = df[[\"label\", \"message\"]].dropna()\n",
        "\n",
        "print(\"Dataset shape:\", df.shape)\n",
        "print(df.head())\n",
        "print(\"\\nClass distribution:\")\n",
        "print(df[\"label\"].value_counts())\n",
        "\n",
        "\n",
        "df[\"label_num\"] = df[\"label\"].map({\"ham\": 0, \"spam\": 1})\n",
        "\n",
        "X = df[\"message\"]\n",
        "y = df[\"label_num\"]\n",
        "\n",
        "\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X, y, test_size=0.20, random_state=42, stratify=y\n",
        ")\n",
        "\n",
        "\n",
        "model = Pipeline([\n",
        "    (\"tfidf\", TfidfVectorizer(\n",
        "        lowercase=True,\n",
        "        stop_words=\"english\",\n",
        "        ngram_range=(1, 2),\n",
        "        min_df=1\n",
        "    )),\n",
        "    (\"classifier\", MultinomialNB())\n",
        "])\n",
        "\n",
        "model.fit(X_train, y_train)\n",
        "\n",
        "\n",
        "y_pred = model.predict(X_test)\n",
        "\n",
        "\n",
        "accuracy = accuracy_score(y_test, y_pred)\n",
        "\n",
        "print(\"\\n--- Model Evaluation ---\")\n",
        "print(f\"Accuracy: {accuracy:.4f} ({accuracy * 100:.2f}%)\")\n",
        "print(\"\\nClassification Report:\")\n",
        "print(classification_report(y_test, y_pred, target_names=[\"Ham\", \"Spam\"]))\n",
        "\n",
        "\n",
        "cm = confusion_matrix(y_test, y_pred)\n",
        "disp = ConfusionMatrixDisplay(\n",
        "    confusion_matrix=cm,\n",
        "    display_labels=[\"Ham\", \"Spam\"]\n",
        ")\n",
        "disp.plot()\n",
        "plt.title(\"Spam Detection Confusion Matrix\")\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"spam_confusion_matrix.png\", dpi=200)\n",
        "plt.show()\n",
        "\n",
        "messages = [\n",
        "    \"Congratulations! You have won a free prize. Call now to claim it.\",\n",
        "    \"Hi, are we still meeting at 5 pm today?\"\n",
        "]\n",
        "\n",
        "predictions = model.predict(messages)\n",
        "\n",
        "print(\"\\n--- Custom Predictions ---\")\n",
        "for message, prediction in zip(messages, predictions):\n",
        "    label = \"SPAM\" if prediction == 1 else \"HAM\"\n",
        "    print(f\"{label}: {message}\")"
      ]
